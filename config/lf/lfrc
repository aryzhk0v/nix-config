# lf configuration adapted from the ranger setup in ../ranger.
# Install this directory as ~/.config/lf (see README.md).

# -----------------------------------------------------------------------------
# Behaviour and appearance
# -----------------------------------------------------------------------------

set shell sh
set shellopts '-eu'
set ifs "\n"

set ratios 1:3:4
set scrolloff 8
set mouse true
set preview true
set dirpreviews true
set preload false
set previewer ~/.config/lf/previewer
set cursorpreviewfmt "\033[7m"

set hidden false
set hiddenfiles ".*:*.pyc:*.pyo:*.bak:*.swp:lost+found:__cache__:__pycache__"
set sortby natural
set reverse false
set sortignorecase true
set dirfirst true
set info size:custom
set history true
set wrapscroll false
set selmode dir
set preserve mode:timestamps
set period 0
set watch true
set icons false

# Preview switches used by previewer. "auto" keeps sixel on Linux and uses
# terminal-safe symbol previews on macOS and in Alacritty.
set user_images true
set user_image_format auto
set user_preview_script true
set user_vcs true

# -----------------------------------------------------------------------------
# Commands
# -----------------------------------------------------------------------------

# Text and source files open in the terminal editor. Everything else follows
# the preferences in ~/.config/lf/opener, the equivalent of ranger's rifle.conf.
cmd open &{{
    set -f
    mime="$(file -Lb --mime-type "$f" 2>/dev/null ||
        file --dereference --brief --mime-type -- "$f")"
    case "$mime" in
        text/html)
            ~/.config/lf/opener $fx
            ;;
        text/*|*/xml|application/json|application/x-shellscript)
            editor="${EDITOR:-vi}"
            editor="${VISUAL:-$editor}"
            lf -remote "send $id \$$editor \$fx"
            ;;
        *)
            ~/.config/lf/opener $fx
            ;;
    esac
}}

cmd edit ${{
    set -f
    editor="${EDITOR:-vi}"
    editor="${VISUAL:-$editor}"
    "$editor" -- $fx
}}

cmd display-file ${{
    set -f
    ~/.config/lf/previewer "$f" "${lf_width:-80}" "${lf_height:-40}" 0 0 preview |
        less -R
}}

cmd terminal $${SHELL:-sh}
cmd open-with-gui &"$@" $fx
cmd open-with-tui $"$@" $fx
cmd open-with-cli %"$@" $fx

cmd log ${{
    if [ -n "${lf_flag_log:-}" ] && [ -f "$lf_flag_log" ]; then
        "${PAGER:-less}" "$lf_flag_log"
    else
        printf '%s\n' 'lf logging is disabled; start lf with: lf -log /path/to/log'
        printf '%s' 'Press enter to continue... '
        read _answer
    fi
}}

cmd mkdir %IFS=" "; mkdir -p -- "$*"
cmd touch %IFS=" "; touch -- "$*"
cmd chmod-mode %chmod "$1" $fx

cmd delete ${{
    set -f
    printf '%s\n' "$fx"
    printf 'delete permanently? [y/N] '
    read answer
    [ "$answer" = y ] || [ "$answer" = Y ] || exit 0
    rm -rf $fx
}}

cmd trash %{{
    set -f
    if [ "$(uname -s)" = Darwin ] && command -v trash >/dev/null 2>&1; then
        trash $fx
    elif [ "$(uname -s)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
        for path in $fx; do
            osascript \
                -e 'on run argv' \
                -e 'tell application "Finder" to delete POSIX file (item 1 of argv)' \
                -e 'end run' \
                "$path"
        done
    elif command -v trash-put >/dev/null 2>&1; then
        trash-put $fx
    elif command -v trash >/dev/null 2>&1; then
        trash $fx
    else
        lf -remote "send $id echoerr 'No trash command is available'"
    fi
}}

cmd trash-empty ${{
    if [ "$(uname -s)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
        osascript -e 'tell application "Finder" to empty trash'
    elif command -v trash-empty >/dev/null 2>&1; then
        trash-empty
    else
        printf '%s\n' 'No command for emptying the trash is available'
        printf '%s' 'Press enter to continue... '
        read _answer
    fi
}}

cmd trash-restore ${{
    if [ "$(uname -s)" = Darwin ] && command -v open >/dev/null 2>&1; then
        open "$HOME/.Trash"
        printf '%s\n' 'The Trash was opened in Finder; restore items there.'
        printf '%s' 'Press enter to continue... '
        read _answer
    elif command -v trash-restore >/dev/null 2>&1; then
        trash-restore
    else
        printf '%s\n' 'No command for restoring trash items is available'
        printf '%s' 'Press enter to continue... '
        read _answer
    fi
}}

cmd fzf-jump ${{
    if ! command -v fzf >/dev/null 2>&1; then
        printf '%s\n' 'fzf is not installed'
        printf '%s' 'Press enter to continue... '
        read _answer
        exit 0
    fi
    target="$(find -L . -mindepth 1 -print 2>/dev/null | fzf)"
    [ -n "$target" ] || exit 0
    case "$target" in
        /*) ;;
        *) target="$PWD/${target#./}" ;;
    esac
    if command -v realpath >/dev/null 2>&1; then
        target="$(realpath "$target")"
    elif [ -d "$target" ]; then
        target="$(CDPATH= cd -P "$target" && pwd -P)"
    else
        target_dir="$(dirname "$target")"
        target_name="$(basename "$target")"
        target_dir="$(CDPATH= cd -P "$target_dir" && pwd -P)"
        target="$target_dir/$target_name"
    fi
    escaped="$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    if [ -d "$target" ]; then
        lf -remote "send $id cd \"$escaped\""
    else
        lf -remote "send $id select \"$escaped\""
    fi
}}

cmd paste-overwrite %{{
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    data_home="${LF_DATA_HOME:-$data_home}"
    buffer="$data_home/lf/files"
    [ -s "$buffer" ] || exit 0
    set -- $(cat "$buffer")
    mode="$1"
    shift
    case "$mode" in
        copy) cp -Rf "$@" . ;;
        move) mv -f "$@" .; lf -remote "send $id clear" ;;
    esac
}}

cmd paste-symlink %{{
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    data_home="${LF_DATA_HOME:-$data_home}"
    buffer="$data_home/lf/files"
    [ -s "$buffer" ] || exit 0
    set -- $(cat "$buffer")
    shift
    [ "$#" -gt 0 ] || exit 0
    for source in "$@"; do
        ln -s "$source" .
    done
}}

cmd paste-relative-symlink %{{
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    data_home="${LF_DATA_HOME:-$data_home}"
    buffer="$data_home/lf/files"
    [ -s "$buffer" ] || exit 0
    set -- $(cat "$buffer")
    shift
    [ "$#" -gt 0 ] || exit 0
    relative_path() {
        source="$1"
        destination="$2"
        source_dir="$(dirname "$source")"
        source_name="$(basename "$source")"
        source_dir="$(CDPATH= cd -P "$source_dir" && pwd -P)" || return 1
        destination="$(CDPATH= cd -P "$destination" && pwd -P)" || return 1

        from="${destination#/}"
        to="${source_dir#/}"
        while [ -n "$from" ] && [ -n "$to" ]; do
            from_part="${from%%/*}"
            to_part="${to%%/*}"
            [ "$from_part" = "$to_part" ] || break
            case "$from" in */*) from="${from#*/}" ;; *) from='' ;; esac
            case "$to" in */*) to="${to#*/}" ;; *) to='' ;; esac
        done

        relative=''
        while [ -n "$from" ]; do
            relative="../$relative"
            case "$from" in */*) from="${from#*/}" ;; *) from='' ;; esac
        done
        [ -z "$to" ] || relative="${relative}${to}/"
        printf '%s%s\n' "$relative" "$source_name"
    }
    for source in "$@"; do
        relative="$(relative_path "$source" "$PWD")" || exit 1
        ln -s "$relative" .
    done
}}

cmd paste-hardlink %{{
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    data_home="${LF_DATA_HOME:-$data_home}"
    buffer="$data_home/lf/files"
    [ -s "$buffer" ] || exit 0
    set -- $(cat "$buffer")
    shift
    [ "$#" -gt 0 ] || exit 0
    for source in "$@"; do
        ln "$source" .
    done
}}

cmd cut-add %~/.config/lf/lf-buffer add move
cmd cut-remove %~/.config/lf/lf-buffer remove move
cmd cut-toggle %~/.config/lf/lf-buffer toggle move
cmd copy-add %~/.config/lf/lf-buffer add copy
cmd copy-remove %~/.config/lf/lf-buffer remove copy
cmd copy-toggle %~/.config/lf/lf-buffer toggle copy

cmd toggle-preview &{{
    if [ "$lf_preview" = true ]; then
        lf -remote "send $id :set preview false; set ratios 1:4"
    else
        lf -remote "send $id :set ratios 1:3:4; set preview true"
    fi
}}

cmd toggle-images &{{
    if [ "$lf_user_images" = true ]; then
        lf -remote "send $id :set user_images false; reload"
    else
        lf -remote "send $id :set user_images true; reload"
    fi
}}

cmd toggle-preview-script &{{
    if [ "$lf_user_preview_script" = true ]; then
        lf -remote "send $id :set user_preview_script false; reload"
    else
        lf -remote "send $id :set user_preview_script true; reload"
    fi
}}

cmd no-feature &{{
    message="$(printf '%s' "$*" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id echoerr \"$message\""
}}

cmd cd-removable &{{
    if [ "$(uname -s)" = Darwin ]; then
        target="/Volumes"
    elif [ -d "/run/media/${USER}" ]; then
        target="/run/media/${USER}"
    elif [ -d "/media/${USER}" ]; then
        target="/media/${USER}"
    else
        target="/media"
    fi
    escaped="$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$escaped\""
}}

cmd cd-trash &{{
    if [ "$(uname -s)" = Darwin ]; then
        target="$HOME/.Trash"
    else
        target="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
    fi
    escaped="$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$escaped\""
}}

cmd cd-remote &{{
    target="$HOME/remote"
    escaped="$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$escaped\""
}}

cmd follow-link &{{
    target="$(readlink "$f")" || exit 0
    case "$target" in
        /*) ;;
        *) target="$(dirname "$f")/$target" ;;
    esac
    escaped="$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id select \"$escaped\""
}}

cmd du-one-level ${{
    set -f
    if du --version >/dev/null 2>&1; then
        du --max-depth=1 -h --apparent-size "$f"
    else
        du -d 1 -h "$f"
    fi
}}

cmd du-one-level-sorted ${{
    set -f
    if du --version >/dev/null 2>&1; then
        du --max-depth=1 -h --apparent-size "$f" | sort -rh
    else
        du -d 1 -h "$f" | sort -rh
    fi
}}

cmd unmount-selected ${{
    if [ "$(uname -s)" = Darwin ] && command -v diskutil >/dev/null 2>&1; then
        diskutil unmount "$f"
    else
        sudo umount "$f"
    fi
}}

cmd cmus-play &cmus-remote $fx
cmd cmus-queue &cmus-remote -q $fx
cmd cmus-lib &cmus-remote -l $fx

# Ranger's vcs_aware option, implemented with lf's custom info column.
cmd on-load &{{
    [ "$lf_user_vcs" = true ] || exit 0
    command -v git >/dev/null 2>&1 || exit 0
    cd "$(dirname -- "$1")" || exit 0
    [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || exit 0
    commands=''
    for path in "$@"; do
        case "$path" in */.git|*/.git/*) continue ;; esac
        status="$(git status --porcelain --ignored -- "$path" 2>/dev/null | cut -c1-2 | head -n 1)"
        escaped_path="$(printf '%s' "$path" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        escaped_status="$(printf '%s' "$status" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        commands="${commands}addcustominfo \"${escaped_path}\" \"${escaped_status}\"; "
    done
    [ -z "$commands" ] || lf -remote "send $id :$commands"
}}

